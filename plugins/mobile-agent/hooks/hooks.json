{
  "description": "Command guards for mobile work. Each handler carries its own `if` — without it, every Bash command in the session would spawn a process. An `if` holds exactly one permission rule (no &&, no ||, no list), so there is one handler per condition, and two ways to invoke the same command become two handlers pointing at the same script.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(adb kill-server)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-adb-kill-server.sh"
          },
          {
            "type": "command",
            "if": "Bash(pkill *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-pkill.sh"
          },
          {
            "type": "command",
            "if": "Bash(pgrep *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-pkill.sh"
          },
          {
            "type": "command",
            "if": "Bash(adb shell uiautomator *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-uiautomator.sh"
          },
          {
            "type": "command",
            "if": "Bash(npx expo run:*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-expo-run.sh"
          },
          {
            "type": "command",
            "if": "Bash(expo run:*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-expo-run.sh"
          },
          {
            "type": "command",
            "if": "Bash(apt install *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-apt-adb.sh"
          },
          {
            "type": "command",
            "if": "Bash(apt-get install *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-apt-adb.sh"
          },
          {
            "type": "command",
            "if": "Bash(sudo apt install *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-apt-adb.sh"
          },
          {
            "type": "command",
            "if": "Bash(sudo apt-get install *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-apt-adb.sh"
          },
          {
            "type": "command",
            "if": "Bash(scrcpy *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-scrcpy.sh"
          },
          {
            "type": "command",
            "if": "Bash(scrcpy)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-scrcpy.sh"
          }
        ]
      }
    ]
  }
}
