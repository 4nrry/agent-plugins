#!/usr/bin/env bash
# tarball-install — installs application tarballs the standardized way on Ubuntu/Kubuntu.
#
# Layout (user mode, default):
#   ~/.local/opt/<app>/<version>/   application files
#   ~/.local/opt/<app>/current  ->  symlink to the active version
#   ~/.local/bin/<app>              executable wrapper (on PATH)
#   ~/.local/share/applications/<app>.desktop
#   ~/.local/share/icons/hicolor/<size>x<size>/apps/<app>.png
#
# --system mode: same shape in /opt/<app>, /usr/local/bin,
#                /usr/local/share/applications, /usr/local/share/icons.
#
# Uninstall: tarball-install --uninstall <app>
set -euo pipefail

SCRIPT_VERSION=1.6

die() { echo "error: $*" >&2; exit 1; }
info() { echo ":: $*"; }

# Under `set -u`, reading $2 of an option with no value aborts with "unbound
# variable". need_arg replaces that with a message saying what is missing.
need_arg() { # $1 = flag, $2 = number of remaining arguments ($#)
    [ "$2" -ge 2 ] || die "option $1 needs a value — see --help"
}

# Writing over a symlink follows the link: with a broken link the command
# fails, and with a valid one it overwrites the wrong file. Every target is
# removed before it is rewritten.
replace() { $SUDO rm -f "$1"; }

# hicolor directory for a PNG: reads the image's real dimensions (the file name
# does not always say) and rounds to a standard theme size — a directory off
# the official scale is ignored by some desktops.
icon_size() { # $1 = file -> "128x128"
    local px std
    px="$(file -b "$1" 2>/dev/null | grep -o '[0-9]\+ x [0-9]\+' | head -1 | cut -d' ' -f1)"
    [ -n "$px" ] || px="$(basename "$1" | grep -o '[0-9]\{2,3\}' | tail -1)"
    [ -n "$px" ] || px=128
    for std in 16 22 24 32 48 64 72 96 128 192 256 512; do
        [ "$px" -le "$std" ] && { echo "${std}x${std}"; return; }
    done
    echo "512x512"
}

# Shrinks a PNG. Returns 1 if the machine has nothing to resize with.
scale_icon() { # $1 = source, $2 = target, $3 = side in pixels
    if command -v magick >/dev/null 2>&1; then
        $SUDO magick "$1" -resize "${3}x${3}" "$2" 2>/dev/null
    elif command -v convert >/dev/null 2>&1; then
        $SUDO convert "$1" -resize "${3}x${3}" "$2" 2>/dev/null
    elif python3 -c 'import PIL' 2>/dev/null; then
        $SUDO python3 -c 'import sys
from PIL import Image
lado = int(sys.argv[3])
Image.open(sys.argv[1]).resize((lado, lado)).save(sys.argv[2])' "$1" "$2" "$3" 2>/dev/null
    else
        return 1
    fi
}

# Returns only the arguments of an Exec= line, dropping the program. Handles
# environment prefixes (`env VAR=1 prog %f`) and a quoted program.
strip_program() { # $1 = Exec= value -> "%f", "--flag %U", ""
    local v="$1" tok rest
    while [ -n "$v" ]; do
        case "$v" in
            \"*) rest="${v#*\"}"; rest="${rest#*\"}"; echo "${rest# }"; return ;;
        esac
        tok="${v%%[[:space:]]*}"
        rest=""
        case "$v" in *[[:space:]]*) rest="${v#*[[:space:]]}" ;; esac
        case "$tok" in
            env|*=*) v="$rest" ;;        # environment prefix: keep looking
            *)       echo "$rest"; return ;;
        esac
    done
    echo ""
}

entry_has() { # $1 = key -> 0 if already in the assembled [Desktop Entry] group
    local k="$1" l
    for l in "${ENTRY[@]:-}"; do [ "${l%%=*}" = "$k" ] && return 0; done
    return 1
}

# Reuses the vendor's official .desktop: all metadata (translated Keywords,
# GenericName and Comment, PrefersNonDefaultGPU, X-*) is kept, and only what
# points at the binary — Exec, TryExec, Icon — is rewritten for this install.
# Command-line flags still have the last word.
parse_vendor() { # $1 = .desktop file; fills ENTRY[], TAIL[], VENDOR_ACTIONS
    local src="$1" line key val group="" a
    ENTRY=(); TAIL=(); VENDOR_ACTIONS=""
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in
            \[*\]) group="$line"
                   [ "$group" = "[Desktop Entry]" ] || TAIL+=("" "$line")
                   continue ;;
        esac
        key="${line%%=*}"; val="${line#*=}"
        # comments and blank lines have no effect and would only disturb the order
        # of the assembled file, since missing keys are appended at the end
        [ "$key" != "$line" ] || continue
        if [ "$group" != "[Desktop Entry]" ]; then
            case "$key" in
                Exec) a="$(strip_program "$val")"; TAIL+=("Exec=$BINDIR/$NAME${a:+ $a}") ;;
                *)    TAIL+=("$line") ;;
            esac
            continue
        fi
        case "$key" in
            Exec)  if [ -n "$EXEC_ARGS" ]; then a="$EXEC_ARGS"; else a="$(strip_program "$val")"; fi
                   ENTRY+=("Exec=$BINDIR/$NAME${a:+ $a}") ;;
            TryExec) ENTRY+=("TryExec=$BINDIR/$NAME") ;;
            Icon)  if [ -n "$ICON_VALUE" ]; then ENTRY+=("Icon=$ICON_VALUE")
                   # with no installed icon, an absolute vendor path would point inside the
                   # original tarball; a bare name can still be resolved by the theme, so
                   # that one is kept.
                   elif [ "${val#/}" = "$val" ]; then ENTRY+=("$line"); fi ;;
            # Path would point at the vendor's build tree, and DBusActivatable needs a
            # D-Bus service this install does not register.
            Path|DBusActivatable) : ;;
            Name|Name\[*\])       [ -n "$TITLE_SET" ]      || ENTRY+=("$line") ;;
            Comment|Comment\[*\]) [ -n "$COMMENT" ]        || ENTRY+=("$line") ;;
            Categories)           [ -n "$CATEGORIES_SET" ] || ENTRY+=("$line") ;;
            MimeType)             [ -n "$MIME" ]           || ENTRY+=("$line") ;;
            StartupWMClass)       [ -n "$WMCLASS_SET" ]    || ENTRY+=("$line") ;;
            Terminal)             [ "$TERMINAL" = "true" ] || ENTRY+=("$line") ;;
            Actions)              VENDOR_ACTIONS="${val%;};" ;;
            *) ENTRY+=("$line") ;;
        esac
    done < "$src"
}

usage() {
    cat <<'EOF'
usage: tarball-install [options] <file.tar.{xz,gz,bz2,zst}>
       tarball-install --uninstall <app>
       tarball-install --list

options:
  -n, --name <slug>        application id (default: derived from the tarball name)
  -N, --title <text>       name shown in the menu (default: the capitalised slug)
  -e, --exec <path>        binary relative to the extracted root (default: autodetect)
  -i, --icon <path>        .png/.svg icon relative to the extracted root, or absolute
                           path to a file outside the tarball (default: autodetect)
  -V, --app-version <tag>  app version label (default: application.ini or the date)
  -a, --args <str>         arguments for the .desktop Exec= (e.g. '%u')
  -c, --categories <str>   Categories= (default: Utility;)
  -m, --mime <str>         MimeType=
  -C, --comment <text>     Comment=
  -A, --action <id|Name|args>   extra .desktop action (repeatable)
      --terminal           run in a terminal (Terminal=true)
      --no-desktop         do not create a menu entry
      --wm-class <str>     StartupWMClass= (default: the slug)
  -D, --vendor-desktop <path>  official .desktop to reuse, relative to the
                           extracted root or absolute (default: autodetect)
      --no-vendor-desktop  ignore the vendor .desktop and generate one from scratch
  -k, --keep <n>           versions to keep in total, including the current one (default: 2)
  -s, --system             install for all users (/opt, needs sudo)
      --version            show this script's version
  -h, --help               this help
EOF
}

# ---------- parsing ----------
NAME=""; TITLE=""; EXEC_REL=""; ICON_REL=""; VERSION=""; EXEC_ARGS=""
CATEGORIES="Utility;"; MIME=""; COMMENT=""; TERMINAL="false"; WMCLASS=""
KEEP=2; SYSTEM=0; MAKE_DESKTOP=1; UNINSTALL=""; LIST=0; TARBALL=""
VENDOR_REL=""; VENDOR_SET=""; USE_VENDOR=1
# Title, categories and wm-class have defaults, so "not empty" cannot tell
# what the user asked for from what the script made up — and only what the
# user asked for may override the vendor's .desktop.
TITLE_SET=""; CATEGORIES_SET=""; WMCLASS_SET=""
declare -a ACTIONS=() ENTRY=() TAIL=()
VENDOR_ACTIONS=""

while [ $# -gt 0 ]; do
    case "$1" in
        -n|--name)        need_arg "$1" $#; NAME="$2"; shift 2 ;;
        -N|--title)       need_arg "$1" $#; TITLE="$2"; TITLE_SET=1; shift 2 ;;
        -e|--exec)        need_arg "$1" $#; EXEC_REL="$2"; shift 2 ;;
        -i|--icon)        need_arg "$1" $#; ICON_REL="$2"; shift 2 ;;
        -V|--app-version) need_arg "$1" $#; VERSION="$2"; shift 2 ;;
        -a|--args)        need_arg "$1" $#; EXEC_ARGS="$2"; shift 2 ;;
        -c|--categories)  need_arg "$1" $#; CATEGORIES="$2"; CATEGORIES_SET=1; shift 2 ;;
        -m|--mime)        need_arg "$1" $#; MIME="$2"; shift 2 ;;
        -C|--comment)     need_arg "$1" $#; COMMENT="$2"; shift 2 ;;
        -A|--action)      need_arg "$1" $#; ACTIONS+=("$2"); shift 2 ;;
        --wm-class)       need_arg "$1" $#; WMCLASS="$2"; WMCLASS_SET=1; shift 2 ;;
        --terminal)       TERMINAL="true"; shift ;;
        --no-desktop)     MAKE_DESKTOP=0; shift ;;
        -D|--vendor-desktop) need_arg "$1" $#; VENDOR_REL="$2"; VENDOR_SET=1; shift 2 ;;
        --no-vendor-desktop) USE_VENDOR=0; shift ;;
        -k|--keep)        need_arg "$1" $#; KEEP="$2"; shift 2 ;;
        -s|--system)      SYSTEM=1; shift ;;
        --uninstall)      need_arg "$1" $#; UNINSTALL="$2"; shift 2 ;;
        --list)           LIST=1; shift ;;
        # --version alone prints the script version; followed by a value it is almost
        # certainly the old intent of labelling the app version, so the script names
        # the right flag instead of silently ignoring the value.
        --version)
            if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then
                die "to label the app version use --app-version $2; --version alone shows the script version"
            fi
            echo "tarball-install $SCRIPT_VERSION"; exit 0 ;;
        -h|--help)        usage; exit 0 ;;
        -*)              die "unknown option: $1" ;;
        *)               TARBALL="$1"; shift ;;
    esac
done

# ---------- targets ----------
if [ "$SYSTEM" = 1 ]; then
    PREFIX=/opt; BINDIR=/usr/local/bin
    APPDIR=/usr/local/share/applications; ICONDIR=/usr/local/share/icons
    SUDO=sudo
else
    PREFIX="$HOME/.local/opt"; BINDIR="$HOME/.local/bin"
    APPDIR="$HOME/.local/share/applications"; ICONDIR="$HOME/.local/share/icons"
    SUDO=""
fi

refresh_caches() {
    # `if` instead of `A && B || true`: the latter trips SC2015 in CI's linter,
    # which is stricter than this machine's. Same behavior — each refresh is
    # best-effort and never breaks the install.
    if command -v update-desktop-database >/dev/null; then
        $SUDO update-desktop-database "$APPDIR" 2>/dev/null || true
    fi
    if command -v gtk-update-icon-cache >/dev/null; then
        $SUDO gtk-update-icon-cache -qtf "$ICONDIR/hicolor" 2>/dev/null || true
    fi
    if command -v kbuildsycoca6 >/dev/null; then
        kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
    fi
}

if [ "$LIST" = 1 ]; then
    for base in "$HOME/.local/opt" /opt; do
        [ -d "$base" ] || continue
        for d in "$base"/*/; do
            [ -L "${d}current" ] || continue
            printf '%-24s %s -> %s\n' "$(basename "$d")" "$base" "$(basename "$(readlink -f "${d}current")")"
        done
    done
    exit 0
fi

if [ -n "$UNINSTALL" ]; then
    app="$UNINSTALL"
    [ -d "$PREFIX/$app" ] || die "not installed in $PREFIX/$app (use --system if it was installed in /opt)"
    $SUDO rm -rf "$PREFIX/$app" "$BINDIR/$app" "$APPDIR/$app.desktop"
    # Without the hicolor directory (app installed with no icon in a fresh HOME)
    # find exits with an error, and under pipefail that killed the script here —
    # after everything was deleted, without the message or the cache refresh.
    if [ -d "$ICONDIR/hicolor" ]; then
        $SUDO find "$ICONDIR/hicolor" \( -name "$app.png" -o -name "$app.svg" \) 2>/dev/null \
            | while read -r f; do $SUDO rm -f "$f"; done || true
    fi
    refresh_caches
    info "removed: $app (profiles/configs in ~/.config and ~/.$app are left untouched)"
    exit 0
fi

[ -n "$TARBALL" ] || { usage; exit 1; }
[ -f "$TARBALL" ] || die "file not found: $TARBALL"
TARBALL="$(readlink -f "$TARBALL")"

# ---------- extract to a temporary area ----------
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
info "extracting $(basename "$TARBALL")"
tar -xf "$TARBALL" -C "$WORK"

# if the tarball has a single top-level directory, use it as the app root
mapfile -t entries < <(find "$WORK" -mindepth 1 -maxdepth 1)
if [ "${#entries[@]}" -eq 1 ] && [ -d "${entries[0]}" ]; then
    ROOT="${entries[0]}"
else
    ROOT="$WORK"
fi

# ---------- name / version / binary / icon ----------
if [ -z "$NAME" ]; then
    NAME="$(basename "$TARBALL")"
    NAME="${NAME%%.tar.*}"                      # strip .tar.xz
    NAME="${NAME%%-linux*}"; NAME="${NAME%%.linux*}"
    NAME="$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g')"
fi
[ -n "$TITLE" ] || TITLE="$(echo "${NAME^}" | tr '-' ' ')"
[ -n "$WMCLASS" ] || WMCLASS="$NAME"

if [ -z "$VERSION" ]; then
    if [ -f "$ROOT/application.ini" ]; then
        VERSION="$(sed -n 's/^Version=//p' "$ROOT/application.ini" | head -1)"
    fi
    [ -n "$VERSION" ] || VERSION="$(date +%Y%m%d)"
fi

if [ -z "$EXEC_REL" ]; then
    if [ -x "$ROOT/$NAME" ] && [ -f "$ROOT/$NAME" ]; then
        EXEC_REL="$NAME"
    else
        EXEC_REL="$(cd "$ROOT" && find . -maxdepth 2 -type f -perm -u+x \
                    ! -name '*.so*' ! -name '*.sh' -printf '%P\n' | head -1)"
    fi
fi
[ -n "$EXEC_REL" ] || die "could not find the executable; pass -e <relative-path>"
[ -x "$ROOT/$EXEC_REL" ] || die "not executable: $EXEC_REL"

if [ -z "$ICON_REL" ]; then
    ICON_REL="$(cd "$ROOT" && find . \( -name '*128*.png' -o -name "$NAME.png" -o -name "$NAME.svg" \) \
                -not -path '*/locale/*' -printf '%P\n' 2>/dev/null | head -1)"
fi

# Many projects (Blender, VS Code, GIMP) already ship the .desktop they publish
# in the distro repositories, with translations, Keywords and keys nobody
# would think to pass by hand — PrefersNonDefaultGPU, for example, is what makes
# the menu offer the discrete GPU. Looking for it costs nothing and gains all that.
if [ "$USE_VENDOR" = 1 ] && [ "$MAKE_DESKTOP" = 1 ] && [ -z "$VENDOR_REL" ]; then
    # -type f is not decoration: the JBR JetBrains ships has directories named
    # java.desktop and jdk.unsupported.desktop (JDK modules), and without it the
    # search would return one of them instead of a menu entry.
    VENDOR_REL="$(cd "$ROOT" 2>/dev/null || exit 0
    {
        find . -maxdepth 1 -type f -name "$NAME.desktop" -printf '%P\n'
        find . -maxdepth 1 -type f -name '*.desktop' -printf '%P\n'
        find . -maxdepth 5 -type f -path '*/applications/*.desktop' -printf '%P\n'
        find . -maxdepth 5 -type f -name '*.desktop' ! -path '*/locale/*' -printf '%P\n'
    } 2>/dev/null | head -1)"
fi
[ "$USE_VENDOR" = 1 ] || VENDOR_REL=""
case "$VENDOR_REL" in
    "") VENDOR_SRC="" ;;
    /*) VENDOR_SRC="$VENDOR_REL" ;;
    *)  VENDOR_SRC="$ROOT/$VENDOR_REL" ;;
esac
# a hand-passed path that does not exist is an error; an autodetected guess
# that does not fit just falls back to generating the entry from scratch
if [ -n "$VENDOR_SRC" ] && [ ! -f "$VENDOR_SRC" ]; then
    [ -z "$VENDOR_SET" ] || die ".desktop not found: $VENDOR_REL"
    VENDOR_SRC=""
fi

# ---------- install ----------
DEST="$PREFIX/$NAME/$VERSION"
[ ! -e "$DEST" ] || DEST="$DEST-$(date +%H%M%S)"
info "installing to $DEST"
$SUDO mkdir -p "$PREFIX/$NAME" "$BINDIR" "$APPDIR"
$SUDO cp -a "$ROOT/." "$DEST/" 2>/dev/null || { $SUDO mkdir -p "$DEST"; $SUDO cp -a "$ROOT/." "$DEST/"; }
[ "$SYSTEM" = 1 ] && $SUDO chown -R root:root "$DEST"

# If `current` is a real directory — typical of an old manual install — ln would
# create the link INSIDE it instead of replacing it. Stopping here beats
# silently removing a directory that may be the user's working install.
if [ -e "$PREFIX/$NAME/current" ] && [ ! -L "$PREFIX/$NAME/current" ]; then
    die "$PREFIX/$NAME/current exists and is not a symlink (old non-standard install). Move or remove that directory and run again; the new version is already in $DEST"
fi
$SUDO ln -sfn "$DEST" "$PREFIX/$NAME/current"

CURRENT="$PREFIX/$NAME/current"
replace "$BINDIR/$NAME"
$SUDO tee "$BINDIR/$NAME" >/dev/null <<EOF
#!/bin/sh
exec "$CURRENT/$EXEC_REL" "\$@"
EOF
$SUDO chmod 755 "$BINDIR/$NAME"

ICON_VALUE=""
# --icon takes a path relative to the extracted root or an absolute path to a
# file outside the tarball — useful when the app ships no loose icon (Electron
# usually keeps it inside app.asar) and you extracted the PNG yourself.
case "$ICON_REL" in
    "")  ICON_SRC="" ;;
    /*)  ICON_SRC="$ICON_REL"
         [ -f "$ICON_SRC" ] || die "icon not found: $ICON_SRC" ;;
    *)   ICON_SRC="$DEST/$ICON_REL" ;;
esac

NATIVE=""
if [ -n "$ICON_SRC" ] && [ -f "$ICON_SRC" ]; then
    case "$ICON_SRC" in
        *.svg) tgt="$ICONDIR/hicolor/scalable/apps/$NAME.svg" ;;
        *)     NATIVE="$(icon_size "$ICON_SRC")"
               tgt="$ICONDIR/hicolor/$NATIVE/apps/$NAME.png" ;;
    esac
    if [ "$(readlink -f "$ICON_SRC")" = "$(readlink -f "$tgt" 2>/dev/null)" ]; then
        # the icon already is the target (reinstall pointing at hicolor): copying it
        # onto itself would destroy the file, so just reuse it
        ICON_VALUE="$NAME"
    else
        $SUDO mkdir -p "$(dirname "$tgt")"
        replace "$tgt"
        $SUDO cp -f "$ICON_SRC" "$tgt"
        ICON_VALUE="$NAME"
    fi
fi

# Installing only a large size is a silent trap: when the menu asks for 32 or
# 48px and finds no usable size, the freedesktop fallback rule cuts the name at
# the hyphen — "antigravity-ide" becomes "antigravity" — and the app shows
# ANOTHER program's icon, which looks like a cache problem but is not.
if [ -n "$ICON_VALUE" ] && [ -n "$NATIVE" ]; then
    for s in 128 256; do
        [ "${NATIVE%%x*}" -gt "$s" ] || continue
        t="$ICONDIR/hicolor/${s}x${s}/apps/$NAME.png"
        $SUDO mkdir -p "$(dirname "$t")"
        replace "$t"
        scale_icon "$ICON_SRC" "$t" "$s" || {
            info "warning: icon only installed at $NATIVE — install imagemagick or python3-pil"
            info "         to generate 128 and 256, or the menu may show another app's icon"
            break
        }
    done
fi

if [ "$MAKE_DESKTOP" = 1 ]; then
    EXEC_LINE="$BINDIR/$NAME"
    [ -n "$EXEC_ARGS" ] && EXEC_LINE="$EXEC_LINE $EXEC_ARGS"

    if [ -n "$VENDOR_SRC" ]; then
        info "reusing the official .desktop: ${VENDOR_REL:-$VENDOR_SRC}"
        parse_vendor "$VENDOR_SRC"
    fi

    # what was asked for explicitly on the command line goes on top
    [ -n "$TITLE_SET" ]      && ENTRY+=("Name=$TITLE")
    [ -n "$COMMENT" ]        && ENTRY+=("Comment=$COMMENT")
    [ -n "$CATEGORIES_SET" ] && ENTRY+=("Categories=$CATEGORIES")
    [ -n "$MIME" ]           && ENTRY+=("MimeType=$MIME")
    [ -n "$WMCLASS_SET" ]    && ENTRY+=("StartupWMClass=$WMCLASS")
    [ "$TERMINAL" = "true" ] && ENTRY+=("Terminal=true")

    # and the rest fills only what is still missing — with no vendor file, this
    # builds the whole entry, as it always did
    entry_has Type           || ENTRY+=("Type=Application")
    entry_has Name           || ENTRY+=("Name=$TITLE")
    entry_has Exec           || ENTRY+=("Exec=$EXEC_LINE")
    entry_has Icon           || [ -z "$ICON_VALUE" ] || ENTRY+=("Icon=$ICON_VALUE")
    entry_has Terminal       || ENTRY+=("Terminal=$TERMINAL")
    entry_has StartupNotify  || ENTRY+=("StartupNotify=true")
    entry_has StartupWMClass || ENTRY+=("StartupWMClass=$WMCLASS")
    entry_has Categories     || ENTRY+=("Categories=$CATEGORIES")
    entry_has MimeType       || [ -z "$MIME" ]    || ENTRY+=("MimeType=$MIME")
    entry_has Comment        || [ -z "$COMMENT" ] || ENTRY+=("Comment=$COMMENT")

    ACT_IDS="$VENDOR_ACTIONS"
    if [ "${#ACTIONS[@]}" -gt 0 ]; then
        for a in "${ACTIONS[@]}"; do ACT_IDS="$ACT_IDS${a%%|*};"; done
    fi
    [ -n "$ACT_IDS" ] && ENTRY+=("Actions=$ACT_IDS")

    {
        echo "[Desktop Entry]"
        for l in "${ENTRY[@]}"; do echo "$l"; done
        if [ "${#TAIL[@]}" -gt 0 ]; then
            for l in "${TAIL[@]}"; do echo "$l"; done
        fi
        if [ "${#ACTIONS[@]}" -gt 0 ]; then
            for a in "${ACTIONS[@]}"; do
                aid="${a%%|*}"; rest="${a#*|}"; alabel="${rest%%|*}"; aargs="${rest#*|}"
                echo ""; echo "[Desktop Action $aid]"
                echo "Name=$alabel"
                echo "Exec=$BINDIR/$NAME $aargs"
            done
        fi
    } | { replace "$APPDIR/$NAME.desktop"; $SUDO tee "$APPDIR/$NAME.desktop" >/dev/null; }
    $SUDO chmod 644 "$APPDIR/$NAME.desktop"
    if command -v desktop-file-validate >/dev/null; then
        desktop-file-validate "$APPDIR/$NAME.desktop" || true
    fi
fi

refresh_caches

# ---------- prune old versions ----------
keep_from="$(readlink -f "$CURRENT")"
mapfile -t olds < <(find "$PREFIX/$NAME" -mindepth 1 -maxdepth 1 -type d ! -path "$keep_from" -printf '%T@ %p\n' \
                    | sort -rn | tail -n +$((KEEP)) | cut -d' ' -f2-)
for o in "${olds[@]:-}"; do
    [ -n "$o" ] || continue
    info "removing old version: $(basename "$o")"
    $SUDO rm -rf "$o"
done

echo
info "$TITLE $VERSION installed"
echo "   app:        $DEST  (current -> $(basename "$keep_from"))"
echo "   command:    $BINDIR/$NAME"
[ "$MAKE_DESKTOP" = 1 ] && echo "   menu:       $APPDIR/$NAME.desktop"
echo "   uninstall:  tarball-install --uninstall $NAME$([ "$SYSTEM" = 1 ] && echo ' --system')"
